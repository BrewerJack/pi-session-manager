{
	"name": "@therealbrewerjack/pi-session-manager",
	"version": "0.3.0",
	"description": "Run pi sessions in the background, detach and reattach them from any terminal, and manage them from a Claude-Code-style overlay. Builds on pi-parallel-sessions (session runtime, path locks, pickers).",
	"type": "module",
	"license": "MIT",
	"author": "John Hautzinger <john@hautzinger.org>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BrewerJack/pi-session-manager.git"
	},
	"homepage": "https://github.com/BrewerJack/pi-session-manager#readme",
	"keywords": [
		"agents",
		"macos",
		"pi",
		"pi-agent",
		"pi-package",
		"sessions"
	],
	"files": [
		"index.ts",
		"host.ts",
		"footer.ts",
		"keys.ts",
		"locks.ts",
		"log.ts",
		"ui.ts",
		"pickers.ts",
		"protocol.ts",
		"socket-terminal.ts",
		"client.ts",
		"worker.ts",
		"worker-boot.mjs",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test 'test/*.test.ts'"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"@earendil-works/pi-tui": "*",
		"@types/node": "*",
		"typescript": "^5.6.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=20"
	}
}
